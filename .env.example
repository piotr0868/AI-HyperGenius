# Copia questo file in .env. Non condividere .env e non inserirlo in Git.
# Groq è il fornitore predefinito. Crea la chiave nel tuo account Free:
# https://console.groq.com/keys — quote e disponibilità dipendono dall'account.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_MIN_INTERVAL_SECONDS=6
# Opzione a pagamento: AI_PROVIDER=openai. Chiave distinta; nessun cambio automatico.
AI_PROVIDER_KEY=
AI_MODEL=gpt-5-mini
APP_PORT=8765
MAX_MODEL_CALLS=12
MAX_TOOL_CALLS=40
MAX_CORRECTIONS=3
MAX_OUTPUT_TOKENS=4000
MAX_TOTAL_TOKENS=120000
COMMAND_TIMEOUT_SECONDS=35
TASK_TIMEOUT_SECONDS=1200
# Stime facoltative: inserisci prezzi correnti del modello in USD per milione.
# Il provider può fatturare diversamente; configura anche i limiti nel suo account.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
MAX_ESTIMATED_COST_USD=
# Valorizzato da prepara_isolamento.py con l'immagine Docker e il digest effettivo.
SANDBOX_IMAGE=
